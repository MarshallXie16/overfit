{
  "name": "overfit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "sim": "tsx tools/headless.ts",
    "build:single": "vite build --config vite.single.config.ts",
    "release:itch": "npm run build:single && mkdir -p release && rm -f release/overfit-itch.zip && cd dist-single && zip -X -q ../release/overfit-itch.zip index.html og.png",
    "test:campaign": "tsx tools/campaign-check.ts",
    "test:soak": "tsx tools/headless.ts --seeds 3 --minutes 12 --size 80,96 --diff veteran --jobs 3 --quiet --strict",
    "test:e2e": "node tools/e2e.mjs && node tools/menus-e2e.mjs",
    "build:artifact": "vite build --config vite.single.config.ts && node tools/make-artifact.mjs",
    "ci": "npm run typecheck && npm test && npm run test:campaign && npm run test:soak && vite build"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
